set -eu

VERSION="0.1.0"

# Detect if running as kubectl plugin
PLUGIN_NAME=$(basename "$0")
case "$PLUGIN_NAME" in
    kubectl-*)
        PLUGIN_MODE=true
        ;;
    *)
        PLUGIN_MODE=false
        ;;
esac

# Terminal colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Global variables
COMMAND=""
POD_NAME=""
NAMESPACE="default"
CONTAINER=""
OBSERVER_MODE=false
USE_LONG_NAMES=false
COOKIE=""
COOKIE_PATH=""
COOKIE_ENV="RELEASE_COOKIE"
EPMD_PORT=4369
DIST_PORT_MIN=9100
DIST_PORT_MAX=9109
PORT_FORWARD_PID=""
INET_TMP_DIR=""

# Common cookie paths to try (space-separated)
COMMON_COOKIE_PATHS="/opt/app/releases/COOKIE /app/releases/COOKIE /opt/release/COOKIE /release/COOKIE $HOME/.erlang.cookie /root/.erlang.cookie"

# Common cookie environment variables (space-separated)
COMMON_COOKIE_ENVS="RELEASE_COOKIE ERLANG_COOKIE COOKIE"

log_info() { printf "${BLUE}==>${NC} %s\n" "$1"; }
log_success() { printf "${GREEN}==>${NC} %s\n" "$1"; }
log_warn() { printf "${YELLOW}==>${NC} %s\n" "$1"; }
log_error() { printf "${RED}Error:${NC} %s\n" "$1" >&2; }

cleanup() {
    if [ -n "${PORT_FORWARD_PID:-}" ] && kill -0 "$PORT_FORWARD_PID" 2>/dev/null; then
        kill "$PORT_FORWARD_PID" 2>/dev/null || true
    fi
    pkill -f "kubectl port-forward.*:$EPMD_PORT" 2>/dev/null || true
    pkill -f "kubectl port-forward.*:$DIST_PORT_MIN" 2>/dev/null || true

    if [ -n "${INET_TMP_DIR:-}" ] && [ -d "$INET_TMP_DIR" ]; then
        rm -rf "$INET_TMP_DIR"
    fi
}

trap cleanup EXIT INT TERM

show_version() {
    echo "kubectl-beam version $VERSION"
}

show_help() {
    cat <<'EOF'
kubectl-beam - Connect to BEAM nodes in Kubernetes pods

Usage:
  kubectl beam iex [flags] POD
  kubectl beam erl [flags] POD

Commands:
  iex         Connect using Elixir's IEx shell
  erl         Connect using Erlang's erl shell

Flags:
  -n, --namespace <namespace>        Kubernetes namespace (default: default)
  -c, --container <container>        Container name (for multi-container pods)
      --observer                     Start Observer GUI connected to remote node
  -l, --long-names                   Use long names instead of short names
      --cookie <cookie>              Erlang cookie (auto-detected if not specified)
      --cookie-path <path>           Path to cookie file on pod
      --cookie-env <var>             Environment variable containing cookie (default: RELEASE_COOKIE)

Examples:
  # Connect to a pod using IEx
  kubectl beam iex my-app-pod

  # Connect to a pod in a specific namespace
  kubectl beam iex -n production my-app-pod

  # Start Observer GUI
  kubectl beam iex --observer -n production my-app-pod

  # Use long names and explicit cookie
  kubectl beam erl -l --cookie secret123 my-app-pod

  # Specify cookie from custom path
  kubectl beam iex --cookie-path /app/config/.cookie my-app-pod

  # Connect to specific container in multi-container pod
  kubectl beam iex -c app-container my-app-pod

EOF
}

check_dependencies() {
    missing=""

    if ! command -v kubectl >/dev/null 2>&1; then
        missing="kubectl"
    fi

    if [ "$COMMAND" = "iex" ] && ! command -v iex >/dev/null 2>&1; then
        missing="$missing iex"
    fi

    if [ "$COMMAND" = "erl" ] && ! command -v erl >/dev/null 2>&1; then
        missing="$missing erl"
    fi

    if [ -n "$missing" ]; then
        log_error "Missing required dependencies:$missing"
        exit 1
    fi

    if [ "$OBSERVER_MODE" = "true" ]; then
        if ! erl -noshell -eval 'wx:new(), init:stop()' 2>/dev/null; then
            log_error "Observer requires Erlang/OTP with wx support"
            exit 1
        fi
    fi
}

parse_args() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    # Parse command
    case "$1" in
    -h | --help)
        show_help
        exit 0
        ;;
    -v | --version)
        show_version
        exit 0
        ;;
    iex | erl)
        COMMAND="$1"
        shift
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
    esac

    # Parse flags
    while [ $# -gt 0 ]; do
        case "$1" in
        -n | --namespace)
            NAMESPACE="$2"
            shift 2
            ;;
        -c | --container)
            CONTAINER="$2"
            shift 2
            ;;
        --observer)
            OBSERVER_MODE=true
            shift
            ;;
        -l | --long-names)
            USE_LONG_NAMES=true
            shift
            ;;
        --cookie)
            COOKIE="$2"
            shift 2
            ;;
        --cookie-path)
            COOKIE_PATH="$2"
            shift 2
            ;;
        --cookie-env)
            COOKIE_ENV="$2"
            shift 2
            ;;
        -h | --help)
            show_help
            exit 0
            ;;
        -*)
            log_error "Unknown flag: $1"
            exit 1
            ;;
        *)
            if [ -z "$POD_NAME" ]; then
                POD_NAME="$1"
                shift
            else
                log_error "Unexpected argument: $1"
                exit 1
            fi
            ;;
        esac
    done

    if [ -z "$POD_NAME" ]; then
        log_error "Pod name is required"
        echo ""
        show_help
        exit 1
    fi
}

kubectl_exec() {
    cmd="$1"
    container_flag=""
    if [ -n "$CONTAINER" ]; then
        container_flag="-c $CONTAINER"
    fi
    # shellcheck disable=SC2086
    kubectl exec -n "$NAMESPACE" $container_flag "$POD_NAME" -- sh -c "$cmd" 2>/dev/null
}

get_cookie() {
    if [ -n "$COOKIE" ]; then
        log_success "Using provided cookie"
        return 0
    fi

    log_info "Detecting cookie from pod..."

    # Try cookie path if specified
    if [ -n "$COOKIE_PATH" ]; then
        COOKIE=$(kubectl_exec "cat $COOKIE_PATH" 2>/dev/null || true)
        if [ -n "$COOKIE" ]; then
            log_success "Retrieved cookie from $COOKIE_PATH"
            return 0
        fi
    fi

    # Try environment variable
    COOKIE=$(kubectl_exec "echo \$$COOKIE_ENV" || true)
    if [ -n "$COOKIE" ]; then
        log_success "Retrieved cookie from environment variable $COOKIE_ENV"
        return 0
    fi

    # Try common environment variables
    for env_var in $COMMON_COOKIE_ENVS; do
        COOKIE=$(kubectl_exec "echo \$$env_var" || true)
        if [ -n "$COOKIE" ]; then
            log_success "Retrieved cookie from environment variable $env_var"
            return 0
        fi
    done

    # Try common paths
    for path in $COMMON_COOKIE_PATHS; do
        COOKIE=$(kubectl_exec "cat $path" 2>/dev/null || true)
        if [ -n "$COOKIE" ]; then
            log_success "Retrieved cookie from $path"
            return 0
        fi
    done

    log_error "Could not detect cookie. Use --cookie or --cookie-path"
    exit 1
}

get_node_info() {
    log_info "Retrieving node information..."

    # Get pod IP
    POD_IP=$(kubectl get pod -n "$NAMESPACE" "$POD_NAME" -o jsonpath='{.status.podIP}')

    if [ -z "$POD_IP" ]; then
        log_error "Could not retrieve pod IP"
        exit 1
    fi

    # Try to get node name from environment
    NODE_NAME=$(kubectl_exec "echo \$NODE_BASENAME" || echo "")

    # If not found, try common alternatives
    if [ -z "$NODE_NAME" ]; then
        NODE_NAME=$(kubectl_exec "echo \$RELEASE_NAME" || echo "")
    fi

    # Fallback to detecting from running nodes
    if [ -z "$NODE_NAME" ]; then
        log_info "Detecting node name from EPMD..."
        # We'll detect this after port-forwarding EPMD
        NODE_NAME=""
    else
        log_success "Node name: $NODE_NAME"
    fi

    log_success "Pod IP: $POD_IP"
}

setup_port_forward() {
    log_info "Setting up port forwarding..."

    # Kill any existing port-forwards
    pkill -f "kubectl port-forward.*:$EPMD_PORT" 2>/dev/null || true
    pkill -f "kubectl port-forward.*:$DIST_PORT_MIN" 2>/dev/null || true
    sleep 1

    # Build port-forward command
    ports="$EPMD_PORT:$EPMD_PORT"
    port=$DIST_PORT_MIN
    while [ $port -le $DIST_PORT_MAX ]; do
        ports="$ports $port:$port"
        port=$((port + 1))
    done

    container_flag=""
    if [ -n "$CONTAINER" ]; then
        container_flag="-c $CONTAINER"
    fi

    # Start port-forward in background
    # shellcheck disable=SC2086
    kubectl port-forward -n "$NAMESPACE" $container_flag "$POD_NAME" $ports >/dev/null 2>&1 &
    PORT_FORWARD_PID=$!

    # Wait for port-forward to be ready
    sleep 2

    if ! kill -0 "$PORT_FORWARD_PID" 2>/dev/null; then
        log_error "Port forwarding failed to start"
        exit 1
    fi

    log_success "Port forwarding established"
}

detect_node_from_epmd() {
    if [ -n "$NODE_NAME" ]; then
        return 0
    fi

    log_info "Querying EPMD for node names..."

    epmd_output=$(epmd -names 2>/dev/null || true)

    if [ -z "$epmd_output" ]; then
        log_error "Could not query EPMD. Is the BEAM node running?"
        exit 1
    fi

    # Parse node names from EPMD output
    nodes=$(echo "$epmd_output" | tail -n +2 | awk '{print $2}')

    node_count=$(echo "$nodes" | wc -w | tr -d ' ')

    if [ "$node_count" -eq 0 ]; then
        log_error "No BEAM nodes found on pod"
        exit 1
    elif [ "$node_count" -eq 1 ]; then
        NODE_NAME="$nodes"
        log_success "Detected node: $NODE_NAME"
    else
        log_error "Multiple BEAM nodes found: $nodes"
        log_error "Please specify the node name using NODE_BASENAME environment variable"
        exit 1
    fi
}

setup_inet_config() {
    log_info "Setting up DNS resolution..."

    INET_TMP_DIR=$(mktemp -d)

    # Create hosts file mapping pod IP and pod name to localhost
    cat >"$INET_TMP_DIR/hosts" <<EOF
127.0.0.1 localhost
127.0.0.1 $POD_IP
127.0.0.1 $POD_NAME
EOF

    # Create inetrc file
    cat >"$INET_TMP_DIR/inetrc" <<EOF
{hosts_file, "$INET_TMP_DIR/hosts"}.
{lookup, [file, native]}.
EOF

    export ERL_INETRC="$INET_TMP_DIR/inetrc"
    log_success "DNS resolution configured"
}

connect_beam() {
    name_flag="sname"
    node_host="$POD_NAME"

    if [ "$USE_LONG_NAMES" = "true" ]; then
        name_flag="name"
        node_host="$POD_IP"
    fi

    remote_node="${NODE_NAME}@${node_host}"
    local_node="kubectl_beam_$$@${node_host}"

    log_success "Connecting to $remote_node"
    echo ""

    if [ "$OBSERVER_MODE" = "true" ]; then
        log_warn "Starting Observer. Close window or press Ctrl+C to exit."
        echo ""

        if [ "$COMMAND" = "iex" ]; then
            iex --"$name_flag" "$local_node" \
                --cookie "$COOKIE" \
                --hidden \
                -e "Node.connect(:\"$remote_node\"); :observer.start()"
        else
            erl -"$name_flag" "$local_node" \
                -setcookie "$COOKIE" \
                -hidden \
                -eval "net_kernel:connect_node('$remote_node'), observer:start()."
        fi
    else
        log_warn "Connected. Press Ctrl+C twice to exit."
        echo ""

        if [ "$COMMAND" = "iex" ]; then
            iex --"$name_flag" "$local_node" \
                --cookie "$COOKIE" \
                --hidden \
                --remsh "$remote_node"
        else
            erl -"$name_flag" "$local_node" \
                -setcookie "$COOKIE" \
                -hidden \
                -remsh "$remote_node"
        fi
    fi
}

main() {
    parse_args "$@"
    check_dependencies
    get_cookie
    get_node_info
    setup_port_forward
    detect_node_from_epmd
    setup_inet_config
    connect_beam
}

main "$@"
