## Name of the node (short name)
## For sname, only use the base name - Erlang adds @hostname automatically
-sname ${NODE_NAME}

## Cookie for distributed erlang
-setcookie ${RELEASE_COOKIE}

## Heartbeat management; auto-restarts VM if it dies or becomes unresponsive
-heart

## Enable kernel poll and async threads
+K true
+A 30

## Increase number of concurrent ports/sockets
-env ERL_MAX_PORTS 65536

## Tweak GC to use fullsweep after 0-20 generations
-env ERL_FULLSWEEP_AFTER 20

## Distribution ports
-kernel inet_dist_listen_min 9100
-kernel inet_dist_listen_max 9109
