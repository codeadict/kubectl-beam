{erl_opts, [debug_info]}.

{deps, []}.

{relx, [
    {release, {erlang_app, "0.1.0"}, [erlang_app, sasl]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {overlay, [
        {copy, "config/vm.args.name", "releases/{{release_version}}/vm.args.name"}
    ]}
]}.
