#!/bin/sh

# Sets and enables heart
case $RELEASE_COMMAND in
  daemon*)
    HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
    export HEART_COMMAND
    export ELIXIR_ERL_OPTIONS="-heart"
    ;;
  *)
    ;;
esac

# Set node name based on environment
# NODE_NAME and POD_IP should be set via Kubernetes env vars
if [ -n "$POD_IP" ] && [ -n "$NODE_NAME" ]; then
  # Determine distribution type based on whether POD_IP contains dots
  case "$POD_IP" in
    *.*)
      # Contains dots - use long names with full node@host
      export RELEASE_DISTRIBUTION=name
      export RELEASE_NODE="${NODE_NAME}@${POD_IP}"
      ;;
    *)
      # No dots - use short names with just the node name (no @host)
      export RELEASE_DISTRIBUTION=sname
      export RELEASE_NODE="${NODE_NAME}"
      ;;
  esac
fi
